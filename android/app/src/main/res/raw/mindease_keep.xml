<?xml version="1.0" encoding="utf-8"?>
<!-- Jitsi's DropboxModule resolves this SDK string by name during startup,
     even when recording/Dropbox features are disabled. Keep its default value;
     this does not enable Dropbox or introduce an application credential.
     The ongoing call notification also looks up its icon by name. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/dropbox_app_key,@drawable/ic_notification" />
